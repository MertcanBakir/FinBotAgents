# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# SEC EDGAR (US company filings, point-in-time). No key; a contact address SEC can reach you at.
#SEC_EDGAR_USER_AGENT=Your Name your@email.com

# Financial Modeling Prep (optional industry P/E benchmark).
#FMP_API_KEY=

# FRED (Federal Reserve macro data). Free key: https://fred.stlouisfed.org/docs/api/api_key.html
#FRED_API_KEY=

# Custom OpenAI-compatible endpoint (vLLM, LM Studio, llama.cpp). Local servers need no key.
#OPENAI_COMPATIBLE_API_KEY=

# AWS Bedrock (pip install ".[bedrock]"). Bearer token, or the AWS credential chain; set the region either way.
#AWS_BEARER_TOKEN_BEDROCK=
#AWS_DEFAULT_REGION=us-west-2
#AWS_PROFILE=

# ChatGPT Plus or Pro plan: no key; sign in once with `finbotagents login chatgpt`.
#FINBOTAGENTS_LLM_PROVIDER=chatgpt

# Override these DEFAULT_CONFIG keys. Provider, models, language and round counts also skip their CLI prompt.
#FINBOTAGENTS_LLM_PROVIDER=openai
#FINBOTAGENTS_DEEP_THINK_LLM=gpt-6-sol
#FINBOTAGENTS_QUICK_THINK_LLM=gpt-6-luna
# A tier on its own provider (set its model above too); its URL only for a local or relay endpoint.
#FINBOTAGENTS_DEEP_THINK_PROVIDER=
#FINBOTAGENTS_QUICK_THINK_PROVIDER=
#FINBOTAGENTS_DEEP_THINK_BACKEND_URL=
#FINBOTAGENTS_QUICK_THINK_BACKEND_URL=
#FINBOTAGENTS_LLM_BACKEND_URL=
#FINBOTAGENTS_OUTPUT_LANGUAGE=English
#FINBOTAGENTS_MAX_DEBATE_ROUNDS=1
#FINBOTAGENTS_MAX_RISK_ROUNDS=1
#FINBOTAGENTS_CHECKPOINT_ENABLED=false

# Docker: a host folder for results, reports and the memory log (unset: the tradingagents_data volume).
#FINBOTAGENTS_DATA_DIR=./data

# Paths and alpha benchmark. Unset uses ~/.tradingagents and the regional index.
#FINBOTAGENTS_RESULTS_DIR=
#FINBOTAGENTS_CACHE_DIR=
#FINBOTAGENTS_MEMORY_LOG_PATH=
#FINBOTAGENTS_BENCHMARK_TICKER=SPY

# Lower temperature means less run-to-run variation on models that honor it.
#FINBOTAGENTS_TEMPERATURE=0.0

# Retry budget for every LLM SDK. Raise it to ride out 429 throttling.
#FINBOTAGENTS_LLM_MAX_RETRIES=6

# Cap output tokens to bound a model that runs long and trips a timeout.
#FINBOTAGENTS_MAX_TOKENS=8192

# Reasoning depth per provider; setting one skips its prompt.
#FINBOTAGENTS_OPENAI_REASONING_EFFORT=medium
#FINBOTAGENTS_GOOGLE_THINKING_LEVEL=high
#FINBOTAGENTS_ANTHROPIC_EFFORT=high
